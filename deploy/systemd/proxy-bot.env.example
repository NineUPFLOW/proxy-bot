# Copy to /etc/proxy-bot.env, set owner root:root and mode 0600.
# Fill these placeholders with real credentials on the server only.
BOT_TOKEN=replace-me
CHAT_ID=-1001234567890
REQUIRE_RU_CHECK=1

# Optional settings:
# TOPIC_ID=123
# BOT_PROXY_URL=socks5://user:password@host:port
# SOURCES_FILE=/etc/proxy-bot/sources.json
